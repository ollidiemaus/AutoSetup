<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- One layout picker: the name box with its label above and a Pick Layout button to its right,
         all hidden with the box. -->
    <EditBox name="AutoSetupLayoutPickerTemplate" inherits="InputBoxTemplate" autoFocus="false" virtual="true">
        <Size>
            <AbsDimension x="260" y="20"/>
        </Size>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT">
                            <Offset>
                                <AbsDimension x="0" y="-2"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="PickButton" inherits="GameMenuButtonTemplate" text="Pick Layout">
                <Size>
                    <AbsDimension x="120" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="10" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>
        </Frames>
    </EditBox>

    <Frame name="AutoSetupOptionsPanel" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad function="AutoSetup_OptionsPanel_OnLoad"/>
        </Scripts>

        <Size>
            <AbsDimension x="700" y="600"/>
        </Size>

        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitleText" inherits="GameFontNormalLarge">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="16" y="-16"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <!-- Profile name -->
            <EditBox name="$parentNameInput" inherits="InputBoxTemplate">
                <Size>
                    <AbsDimension x="200" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-50"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>

            <Frame>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString inherits="GameFontNormal" text="Profile Name">
                            <Anchors>
                                <!-- Label above the input -->
                                <Anchor point="BOTTOMLEFT" relativeTo="$parentNameInput" relativePoint="TOPLEFT">
                                    <Offset>
                                        <AbsDimension x="0" y="-2"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Resolution -->
            <EditBox name="$parentResInput" inherits="InputBoxTemplate">
                <Size>
                    <AbsDimension x="140" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-100"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>

            <Frame>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString inherits="GameFontNormal" text="Resolution (e.g. 1920x1080)">
                            <Anchors>
                                <!-- Label above the input -->
                                <Anchor point="BOTTOMLEFT" relativeTo="$parentResInput" relativePoint="TOPLEFT">
                                    <Offset>
                                        <AbsDimension x="0" y="-2"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <Button name="$parentUseCurrentResButton" inherits="GameMenuButtonTemplate" text="Use Current">
                <Size>
                    <AbsDimension x="120" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentResInput" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="10" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <!-- Base and Target layout per input mode; AutoSetup_Options.lua stacks the shown ones from y = -150 -->
            <EditBox name="$parentKeyboardBaseLayoutInput" inherits="AutoSetupLayoutPickerTemplate"/>
            <EditBox name="$parentKeyboardTargetLayoutInput" inherits="AutoSetupLayoutPickerTemplate"/>
            <EditBox name="$parentControllerBaseLayoutInput" inherits="AutoSetupLayoutPickerTemplate"/>
            <EditBox name="$parentControllerTargetLayoutInput" inherits="AutoSetupLayoutPickerTemplate"/>

            <!-- UI scale: unticked leaves the scale alone -->
            <CheckButton name="$parentScaleCheck" inherits="ChatConfigCheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="456" y="-100"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </CheckButton>

            <!-- UI Scale slider -->
            <Slider name="$parentScaleSlider" minValue="0.65" maxValue="1.15" valueStep="0.01" inherits="OptionsSliderTemplate">
                <Size>
                    <AbsDimension x="200" y="17"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="460" y="-150"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>

            <!-- Damage Meter: right column, which stays fixed while the layout pickers come and go -->
            <Button name="$parentDamageMeterButton" inherits="GameMenuButtonTemplate">
                <Size>
                    <AbsDimension x="200" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="460" y="-200"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <!-- Controller support: Leave alone / On / Off, a button like the Damage Meter's -->
            <Button name="$parentControllerSupportButton" inherits="GameMenuButtonTemplate">
                <Size>
                    <AbsDimension x="200" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="460" y="-250"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <!-- Addons input -->
            <EditBox name="$parentAddonsInput" inherits="InputBoxTemplate" multiLine="true">
                <Size>
                    <AbsDimension x="620" y="50"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-360"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>

            <Frame>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString inherits="GameFontHighlightSmall"
                                    text="AddOns (comma-separated; prefix with ! to disable, e.g. WeakAuras, !Details). Features: QoL:viewport">
                            <Anchors>
                                <!-- Label above the multi-line input -->
                                <Anchor point="BOTTOMLEFT" relativeTo="$parentAddonsInput" relativePoint="TOPLEFT">
                                    <Offset>
                                        <AbsDimension x="0" y="-2"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Save / Clear buttons -->
            <Button name="$parentSaveButton" inherits="GameMenuButtonTemplate" text="Save / Update">
                <Size>
                    <AbsDimension x="140" y="30"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-425"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <Button name="$parentClearButton" inherits="GameMenuButtonTemplate" text="Clear Form">
                <Size>
                    <AbsDimension x="120" y="30"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentSaveButton" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="10" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <!-- Profiles list -->
            <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Size>
                    <AbsDimension x="620" y="130"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentSaveButton" relativePoint="BOTTOMLEFT">
                        <Offset>
                            <AbsDimension x="0" y="-10"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <ScrollChild>
                    <Frame name="$parentListContent">
                        <Size>
                            <AbsDimension x="640" y="400"/>
                        </Size>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>
</Ui>